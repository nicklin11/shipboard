# onnxruntime session config for alter-talk's sherpa-onnx keyword spotter.
# Passed via provider string "cpu:<this file>" (sherpa-onnx >= 1.13.x).
#
# Keys prefixed with SessionConfig. are forwarded verbatim (prefix stripped)
# to Ort::SessionOptions::AddConfigEntry.
#
# allow_spinning=0 stops onnxruntime's intra/inter-op thread pools from
# busy-spinning while waiting for the next decode chunk. Without this, the
# three KWS sessions (encoder/decoder/joiner) burn ~3 full cores of idle CPU
# even when decoding only needs ~1.5% of one core.
SessionConfig.session.intra_op.allow_spinning=0
SessionConfig.session.inter_op.allow_spinning=0
