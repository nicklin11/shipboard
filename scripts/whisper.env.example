# GPU host: use localhost. On another tailnet device, use:
# WHISPER_CPP_URL=http://<your-machine>.headscale.local:8080/inference
# WHISPER_CPP_HEALTH_URL=http://<your-machine>.headscale.local:8080/health
WHISPER_CPP_URL=http://127.0.0.1:10300/inference
WHISPER_CPP_HEALTH_URL=http://127.0.0.1:10300/health
WHISPER_AUTOSTART=auto
