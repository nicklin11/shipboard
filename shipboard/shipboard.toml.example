# shipboard configuration
# Precedence: defaults < this file < environment variables (ALTER_TALK_*).
# Generate your own copy with: shipboard config
# (default location: ~/.config/shipboard/shipboard.toml)

# Speech-to-text server (local wake proxy or a remote tailnet host)
whisper_url = "http://127.0.0.1:10300/inference"
whisper_health_url = "http://127.0.0.1:10300/health"
whisper_container = "whisper-local"
whisper_language = "auto"   # whisper language: auto / ru / en / ...

# Recording
max_hold = 60          # seconds; force-finish a stuck recording
min_recording = 0.5    # seconds; shorter recordings are discarded
record_rate = 16000    # sample rate for pw-record and the wake listener
record_channels = 1    # channels for pw-record and the wake listener

# Keys the daemon listens on (evdev names, see linux/input-event-codes.h:
# pause, scrolllock, insert, home, f13, ...). Defaults: Pause/ScrollLock.
# An empty string ("") disables a trigger entirely (wake words still work).
key_record = "pause"
key_send = "scrolllock"
# key_record_send = "insert"   # optional: single key for record + paste + Enter
key_record_mode = "hold"        # hold: record while held | toggle: press to start/stop

# Send mode (Scroll Lock / both keys)
paste_combo = "ctrl+shift+v"   # injected as a modifier combo (layout-proof)
send_enter = true              # also press Enter after pasting

# Both-keys detection window (seconds): Scroll Lock pressed this long before
# Pause is still treated as "both held".
grace = 0.15

# Dictation normalization: "тильда слэш точка конфиг" -> "~/.config"
normalize = true

# Optional initial prompt sent to whisper (domain vocabulary).
# prompt = "Короткие команды на русском и английском, термины: Docker, config"

# Record source for pw-record. "default" (or empty) = system default source
# (e.g. the EasyEffects chain); a device name pins recording to it.
# record_target = "default"
# record_target = "alsa_input.pci-0000_00_1f.3.analog-stereo"

# Wake word listener (sherpa-onnx KWS by default; venv at
# ~/.local/share/shipboard-venv, model auto-downloads on first run).
# wakeword_enabled = false
# wakeword_engine = "sherpa"      # sherpa (open-vocab phrases) | openwakeword
# wakeword_keywords = "alter capture:record, alter send:record_send"
#   phrase:action pairs — record (clipboard) | record_send (paste+Enter)
# wakeword_sensitivity = 0.5      # openwakeword only, 0..1
# wakeword_cooldown = 2.0         # seconds between triggers
# wakeword_grace = 3.0            # keep recording through silence right after a trigger
# wakeword_max_record = 30.0      # cap for recording after a trigger
# wakeword_stop_silence = 1.5     # seconds of silence end the recording
# wakeword_silence_level = 500    # RMS below this counts as silence
# wakeword_model = "hey_jarvis"   # openwakeword only: name or .onnx path
# kws_threads = 2                 # sherpa KWS: onnxruntime threads

# Platform / backend overrides (auto = best for the running session)
# keep_audio_dir = ""             # keep recordings here instead of deleting them
# dry_run = false                 # log actions without performing them
# inject_backend = "auto"         # auto | uinput | wtype | pynput
# notify_backend = "auto"         # auto | notify-send | osascript | powershell
# clipboard_backend = "auto"      # auto | wl-copy | xclip | pbcopy | clip
# record_backend = "auto"         # auto | pw-record | ffmpeg
# input_device_glob = ""          # evdev device glob, e.g. /dev/input/event*
